 <div class="container">
      <div class="row justify-content-center">
        <%= render 'shared/errors', obj: @category %>

        <%= form_with model: @category, class: "shadow p-4 mb-3 bg-info rounded", local: true do |f| %>
          <div class="form-group row">
            <%= f.label :name, "Category Name", class: "col-2 col-form-label text-light" %><br>
            <div class="mb-3 col-10">
              <%= f.text_field :name, class: "form-control shadow rounded", placeholder: "Enter a category name" %>
            </div>
          </div>

          <div class="row justify-content-center">
            <div class="col-auto">
              <%= f.submit(@category.new_record? ? "Create Category" : "Update Category", class: "btn btn-outline-light btn-lg") %>
            </div>
          </div>
        <% end %>
      </div>
