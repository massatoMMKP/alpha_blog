<div class="container">
  

  <div class="row justify-content-center">
    <%= render 'shared/errors', obj: @article %>
    <%= form_with model: @article, class: "shadow p-4 mb-3 bg-info rounded", local: true do |f| %>
      <div class="form-group row">
        <%= f.label :title, class: "col-2 col-form-label text-light" %><br>
        <div class="mb-3 col-10">
          <%= f.text_field :title, class: "form-control shadow rounded", placeholder: "Title of article" %>
        </div>
      </div>

      <div class="form-group row">
        <%= f.label :description, class: "col-2 col-form-label text-light" %><br>
        <div class="mb-3 col-10">
          <%= f.text_area :description, rows: 10, class: "form-control shadow rounded", placeholder: "Description of article" %>
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-auto">
          <%= f.submit(@article.new_record? ? "Create Article" : "Update Article", class: "btn btn-outline-light btn-lg") %>
        </div>
      </div>

      
    <% end %>
  </div>
  <div class="row justify-content-center mt-3">
        <div class="col-auto">
          <%= link_to '[ Cancel and return to articles listing ]', articles_path, class: "text-info" %>
        </div>
      </div>
</div>
